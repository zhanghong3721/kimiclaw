{"type":"message","id":"845a3280","parentId":"dd76ca89","timestamp":"2026-07-27T08:26:31.412Z","message":{"role":"toolResult","toolCallId":"tool_vgDO5kqr1MX1HK3D2c3nLKBA","toolName":"exec","content":[{"type":"text","text":"{\n  \"id\": \"kimi-claw\",\n  \"name\": \"kimi-claw\",\n  \"description\": \"Connector plugin that bridges a remote /gateway server with the local OpenClaw Gateway.\",\n  \"version\": \"0.27.1\",\n  \"activation\": {\n    \"onStartup\": true\n  },\n  \"configSchema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": true,\n    \"properties\": {\n      \"bridge\": {\n        \"type\": \"object\",\n        \"additionalProperties\": true,\n        \"properties\": {\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"userId\": {\n            \"type\": \"string\"\n          },\n          \"token\": {\n            \"type\": \"string\"\n          },\n          \"kimiapiHost\": {\n            \"type\": \"string\"\n          },\n          \"outboundTransport\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"im_rpc\",\n              \"bridge_ws\"\n            ]\n          },\n          \"protocol\": {\n            \"type\": \"number\"\n          },\n          \"instanceId\": {\n            \"type\": \"string\"\n          },\n          \"deviceId\": {\n            \"type\": \"string\"\n          },\n          \"forwardThinking\": {\n            \"type\": \"boolean\",\n            \"default\": true\n          },\n          \"forwardToolCalls\": {\n            \"type\": \"boolean\",\n            \"default\": true\n          },\n          \"promptTimeoutMs\": {\n            \"type\": \"number\"\n          },\n          \"historyPendingTimeoutMs\": {\n            \"type\": \"number\"\n          },\n          \"cronSessionTarget\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"isolated\",\n              \"main\"\n            ]\n          },\n          \"kimiCodeAPIKey\": {\n            \"type\": \"string\"\n          },\n          \"kimiCodeBaseURL\": {\n            \"type\": \"string\"\n          },\n          \"shell\": {\n            \"type\": \"object\",\n            \"additionalProperties\": true,\n            \"properties\": {\n              \"enabled\": {\n                \"type\": \"boolean\"\n              },\n              \"maxConcurrentSessions\": {\n                \"type\": \"number\"\n              },\n              \"idleTimeoutMs\": {\n                \"type\": \"number\"\n              },\n              \"maxDurationMs\": {\n                \"type\": \"number\"\n              },\n              \"defaultShell\": {\n                \"type\": \"string\"\n              }\n            }\n          },\n          \"terminalWs\": {\n            \"type\": \"object\",\n            \"additionalProperties\": true,\n            \"properties\": {\n              \"enabled\": {\n                \"type\": \"boolean\"\n              },\n              \"port\": {\n                \"type\": \"number\"\n              },\n              \"host\": {\n                \"type\": \"string\"\n              },\n              \"path\": {\n                \"type\": \"string\"\n              },\n              \"token\": {\n                \"type\": \"string\"\n              },\n              \"allowedOrigins\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"string\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"gateway\": {\n        \"type\": \"object\",\n        \"additionalProperties\": true,\n        \"properties\": {\n          \"url\": {\n            \"type\": \"string\"\n          },\n          \"token\": {\n            \"type\": \"string\"\n          },\n          \"protocol\": {\n            \"type\": \"number\"\n          },\n          \"clientId\": {\n            \"type\": \"string\"\n          },\n          \"clientMode\"