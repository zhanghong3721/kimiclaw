": {}\n      },\n      \"error\": \"bundled (disabled by default)\"\n    },\n    {\n      \"id\": \"openclaw-diagnostics-metrics-cls\",\n      \"name\": \"Diagnostics Metrics\",\n      \"description\": \"CLS诊断指标导出插件：Prometheus 指标（pull/remote-write）+ 全链路 Trace\",\n      \"version\": \"3.0.0\",\n      \"source\": \"/root/.openclaw/extensions/.openclaw-install-stage-a7S8DA/dist/index.js\",\n      \"origin\": \"global\",\n      \"enabled\": true,\n      \"status\": \"loaded\",\n      \"toolNames\": [],\n      \"hookNames\": [],\n      \"channelIds\": [],\n      \"providerIds\": [],\n      \"gatewayMethods\": [],\n      \"cliCommands\": [],\n      \"services\": [\n        \"diagnostics-metrics-cls-shared-credential\",\n        \"openclaw-diagnostics-metrics-cls\",\n        \"diagnostics-metrics-cls-trace\"\n      ],\n      \"commands\": [],\n      \"httpRoutes\": 1,\n      \"hookCount\": 19,\n      \"configSchema\": true,\n      \"configJsonSchema\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"prometheus\": {\n            \"type\": \"object\",\n            \"description\": \"Prometheus 指标导出配置\",\n            \"additionalProperties\": false,\n            \"properties\": {\n              \"enabled\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用 Prometheus 指标导出，默认 true\"\n              },\n              \"metric_prefix\": {\n                \"type\": \"string\",\n                \"description\": \"指标名称前缀，默认 openclaw\"\n              },\n              \"pull\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用 /metrics HTTP pull 端点，默认 true\"\n              },\n              \"default_metrics\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否采集 Node.js 默认指标（GC、事件循环等），默认 true\"\n              },\n              \"external_labels\": {\n                \"type\": \"object\",\n                \"description\": \"附加到所有指标的自定义标签\",\n                \"additionalProperties\": {\n                  \"type\": \"string\"\n                }\n              },\n              \"remote_write\": {\n                \"type\": \"array\",\n                \"description\": \"Prometheus Remote Write 目标列表\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"required\": [\n                    \"url\"\n                  ],\n                  \"additionalProperties\": false,\n                  \"properties\": {\n                    \"url\": {\n                      \"type\": \"string\",\n                      \"description\": \"Remote Write 端点 URL\"\n                    },\n                    \"headers\": {\n                      \"type\": \"object\",\n                      \"description\": \"附加 HTTP 请求头\",\n                      \"additionalProperties\": {\n                        \"type\": \"string\"\n                      }\n                    },\n                    \"tls_config\": {\n                      \"type\": \"object\",\n                      \"description\": \"TLS 配置\",\n                      \"additionalProperties\": false,\n                      \"properties\": {\n                        \"ca_file\": {\n                          \"type\": \"string\"\n                        },\n                        \"cert_file\": {\n                          \"type\": \"string\"\n                        },\n                        \"key_file\": {\n                          \"type\": \"string\"\n                        },\n                        \"insecure_skip_verify\": {\n                          \"type\": \"boolean\"\n                        }\n                      }\n                    },\n                    \"queue_config\": {\n                      \"type\": \"object\",\n                      \"description\": \"发送队列配置\",\n                      \"additionalProperties\": false,\n                      \"properties\": {\n                        \"capacity\": {\n                          \"type\": \"number\"\n                        },\n                        \"max_samples_per_send\": {\n                          \"type\": \"number\"\n                        },\n                        \"batch_send_deadline_ms\": {\n                          \"type\": \"number\"\n                        },\n                        \"max_retries\": {\n                          \"type\": \"number\"\n                        },\n                        \"min_backoff_ms\": {\n                          \"type\": \"number\"\n                        },\n                        \"max_backoff_ms\": {\n                          \"type\": \"number\"\n                        },\n                        \"max_consecutive_failures\": {\n                          \"type\": \"number\",\n                          \"description\": \"连续批次发送失败的最大次数，超过后熔断器打开并停止发送，直到配置更新后自动恢复，默认 5\"\n                        }\n                      }\n                    }\n                  }\n                }\n              },\n              \"push_interval_ms\": {\n                \"type\": \"number\",\n                \"description\": \"Remote Write 推送间隔（毫秒），默认 30000\"\n              }\n            }\n          },\n          \"instance_metadata\": {\n            \"type\": \"object\",\n            \"description\": \"实例元数据持久化（插件自动管理，无需手动配置）\",\n            \"additionalProperties\": false,\n            \"properties\": {\n              \"instance_id\": {\n                \"type\": \"string\",\n                \"description\": \"腾讯云 CVM 实例 ID，由插件自动获取并持久化\"\n              },\n              \"instance_name\": {\n                \"type\": \"string\",\n                \"description\": \"腾讯云 CVM 实例名称，由插件自动获取并持久化\"\n              },\n              \"local_ipv4\": {\n                \"type\": \"string\",\n                \"description\": \"腾讯云 CVM 内网 IPv4 地址，由插件自动获取并持久化\"\n              }\n            }\n          },\n          \"cls\": {\n            \"type\": \"object\",\n            \"description\": \"腾讯云 CLS Prometheus Remote Write 凭证与接入配置\",\n            \"additionalProperties\": false,\n            \"required\": [\n              \"endpoint\"\n            ],\n            \"properties\": {\n              \"metricTopicId\": {\n                \"type\": \"string\",\n                \"description\": \"Prometheus Remote Write 使用的 CLS 日志主题 ID，用于构建推送 URL\"\n              },\n              \"secretId\": {\n                \"type\": \"string\",\n                \"description\": \"腾讯云 SecretId\"\n              },\n              \"secretKey\": {\n                \"type\": \"string\",\n                \"description\": \"腾讯云 SecretKey\"\n              },\n              \"endpoint\": {\n                \"type\": \"string\",\n                \"description\": \"CLS 接入点，例如 ap-guangzhou.cls.tencentcs.com 或 ap-guangzhou-open.cls.tencentcs.com\"\n              },\n              \"credentialMode\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"static\",\n                  \"cvmRole\"\n                ],\n                \"description\": \"凭证模式：static（静态密钥，默认）或 cvmRole（CVM 角色临时密钥）\"\n              },\n              \"roleName\": {\n                \"type\": \"string\",\n                \"description\": \"CVM 角色名称，credentialMode 为 cvmRole 时必填\"\n              },\n              \"credentialRefreshIntervalMs\": {\n                \"type\": \"number\",\n                \"minimum\": 60000,\n                \"description\": \"CVM 角色临时密钥刷新间隔（毫秒），仅在 credentialMode 为 cvmRole 时有效，默认 300000（5分钟）\"\n              },\n              \"enableReport\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用指标推送，false 时插件不通过 Remote Write 推送任何指标数据，默认 true\"\n              }\n            }\n          },\n          \"log\": {\n            \"type\": \"object\",\n            \"description\": \"CLS 日志上报配置，将 OpenClaw 的 gateway 运行日志、会话日志（session JSONL）实时上报到腾讯云 CLS。复用 cls 配置中的凭证（secretId / secretKey / endpoint），只需独立配置 enableLogReport 和 logTopicId。\",\n            \"additionalProperties\": false,\n            \"properties\": {\n              \"enableLogReport\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用日志上报，默认 false\"\n              },\n              \"logTopicId\": {\n                \"type\": \"string\",\n                \"description\": \"日志上报使用的 CLS 日志主题 ID\"\n              },\n              \"source\": {\n                \"type\": \"string\",\n                \"description\": \"日志来源标识，默认 openclaw\"\n              },\n              \"enableGatewayLog\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用 gateway 运行日志上报，默认 true\"\n              },\n              \"enableSessionLog\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用会话日志上报（session JSONL），默认 true\"\n              },\n              \"minLevel\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"trace\",\n                  \"debug\",\n                  \"info\",\n                  \"warn\",\n                  \"error\",\n                  \"fatal\"\n                ],\n                \"description\": \"最低上报日志级别（仅对 gateway 运行日志生效），默认 info\"\n              },\n              \"sendTimeThreshold\": {\n                \"type\": \"number\",\n                \"description\": \"异步发送时间阈值（秒），默认 2\"\n              },\n              \"sendCountThreshold\": {\n                \"type\": \"number\",\n                \"description\": \"异步发送条数阈值，默认 1000\"\n              }\n            }\n          },\n          \"trace\": {\n            \"type\": \"object\",\n            \"description\": \"CLS 全链路 Trace 追踪配置，复用 cls 配置中的凭证（secretId / secretKey / endpoint），只需独立配置 enabled 和 traceTopicId\",\n            \"additionalProperties\": false,\n            \"properties\": {\n              \"enabled\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用 Trace 链路追踪功能，默认 false\"\n              },\n              \"traceTopicId\": {\n                \"type\": \"string\",\n                \"description\": \"Trace 数据上报使用的 CLS 日志主题 ID\"\n              },\n              \"serviceName\": {\n                \"type\": \"string\",\n                \"default\": \"openclaw-agent\",\n                \"description\": \"服务名称，用于标识 Trace 数据来源，默认 openclaw-agent\"\n              },\n              \"debug\": {\n                \"type\": \"boolean\",\n                \"default\": false,\n                \"description\": \"是否开启 Trace 调试日志\"\n              },\n              \"batchSize\": {\n                \"type\": \"number\",\n                \"default\": 10,\n                \"description\": \"Span 缓冲区大小，达到此数量后触发批量发送\"\n              },\n              \"flushIntervalMs\": {\n                \"type\": \"number\",\n                \"default\": 5000,\n                \"description\": \"Span 缓冲区最大等待时间（毫秒），超时后强制发送\"\n              },\n              \"enabledHooks\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"string\"\n                },\n                \"description\": \"启用的 hook 列表，不设置则全部启用。可选值（与 OpenClaw PLUGIN_HOOK_NAMES 对齐）：gateway_start, gateway_stop, session_start, session_end, message_received, message_sending, message_sent, llm_input, llm_output, before_message_write, before_tool_call, after_tool_call, before_compaction, after_compaction, subagent_spawned, subagent_ended, before_agent_start, agent_end, before_reset\"\n              }\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"dingtalk-connector\",\n      \"name\": \"DingTalk Channel\",\n      \"description\": \"DingTalk (钉钉) messaging channel via Stream mode with AI Card streaming\",\n      \"version\": \"0.8.1\",\n      \"source\": \"/root/.openclaw/extensions/dingtalk-connector/index.ts\",\n      \"origin\": \"global\",\n      \"enabled\": true,\n      \"status\": \"loaded\",\n      \"