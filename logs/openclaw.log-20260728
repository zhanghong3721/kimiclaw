": {}\n      },\n      \"error\": \"bundled (disabled by default)\"\n    },\n    {\n      \"id\": \"openclaw-diagnostics-metrics-cls\",\n      \"name\": \"Diagnostics Metrics\",\n      \"description\": \"CLS诊断指标导出插件：Prometheus 指标（pull/remote-write）+ 全链路 Trace\",\n      \"version\": \"3.0.0\",\n      \"source\": \"/root/.openclaw/extensions/.openclaw-install-stage-a7S8DA/dist/index.js\",\n      \"origin\": \"global\",\n      \"enabled\": true,\n      \"status\": \"loaded\",\n      \"toolNames\": [],\n      \"hookNames\": [],\n      \"channelIds\": [],\n      \"providerIds\": [],\n      \"gatewayMethods\": [],\n      \"cliCommands\": [],\n      \"services\": [\n        \"diagnostics-metrics-cls-shared-credential\",\n        \"openclaw-diagnostics-metrics-cls\",\n        \"diagnostics-metrics-cls-trace\"\n      ],\n      \"commands\": [],\n      \"httpRoutes\": 1,\n      \"hookCount\": 19,\n      \"configSchema\": true,\n      \"configJsonSchema\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n          \"prometheus\": {\n            \"type\": \"object\",\n            \"description\": \"Prometheus 指标导出配置\",\n            \"additionalProperties\": false,\n            \"properties\": {\n              \"enabled\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用 Prometheus 指标导出，默认 true\"\n              },\n              \"metric_prefix\": {\n                \"type\": \"string\",\n                \"description\": \"指标名称前缀，默认 openclaw\"\n              },\n              \"pull\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否启用 /metrics HTTP pull 端点，默认 true\"\n              },\n              \"default_metrics\": {\n                \"type\": \"boolean\",\n                \"description\": \"是否采集 Node.js 默认指标（GC、事件循环等），默认 true\"\n              },\n              \"external_labels\": {\n                \"type\": \"object\",\n                \"description\": 